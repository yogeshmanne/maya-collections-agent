# Local dev: point at any Postgres instance. Production: RDS / Supabase / Cloud SQL / etc.
DATABASE_URL="postgresql://user:password@localhost:5432/kapture_collections"
PORT=3000
NODE_ENV=development

# Vapi signs its webhook requests — set the same secret here and in the Vapi
# dashboard's tool configuration so /webhook can verify authenticity.
VAPI_WEBHOOK_SECRET=

# Twilio — leave blank to run send_payment_link in dry-run mode (logs the
# message instead of sending). Fill in to send real SMS/WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# KYC provider — leave blank to use the built-in mock verification adapter.
# Fill in to swap in a real provider (Karza, Signzy, DigiLocker, etc.) via
# src/integrations/kyc.js.
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_BASE_URL=
